{
  "name": "create-custom-next-app",
  "version": "1.0.0",
  "description": "A custom version of create-next-app with automated boilerplate injection.",
  "main": "dist/index.js",
  "bin": {
    "create-custom-next-app": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs --watch"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
